# Insert into the customer's existing HTTPS server block.
# TLS certificate paths and the public server_name belong to that deployment.
# Serve Dashboard at a dedicated host root, e.g. https://research.example.com/.
location / {
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
# Preserve the application's CSP frame-ancestors header.
# Do not add an X-Frame-Options header that conflicts with permitted customers.
