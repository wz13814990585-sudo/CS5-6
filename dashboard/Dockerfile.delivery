FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY dashboard/requirements.txt /app/dashboard/requirements.txt
RUN pip install --no-cache-dir -r dashboard/requirements.txt && useradd --uid 10001 --create-home appuser
COPY dashboard/server/ /app/dashboard/server/
COPY dashboard/start.py /app/dashboard/start.py
COPY dashboard/frontend/dist/ /app/dashboard/frontend/dist/
COPY FINAL_OUTPUTS/ /app/FINAL_OUTPUTS/
COPY config.toml /app/config.toml
USER appuser
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=4)"
CMD ["python", "dashboard/start.py", "--config", "/app/config.toml", "--host", "0.0.0.0", "--port", "8000"]
